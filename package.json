{
  "name": "reciclajes-bajo-cinca",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm ci --prefix modules/accounting",
    "dev": "npm run build:accounting && concurrently -k -n API,WEB -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:accounting && npm run build --prefix frontend",
    "build:accounting": "npm run build --prefix modules/accounting",
    "deploy:build": "npm run install:all && npm run build",
    "start": "npm start --prefix backend",
    "config:check": "npm run config:check --prefix backend",
    "db:check:accounting": "npm run db:check:accounting --prefix backend",
    "test": "npm test --prefix backend && npm run test:accounting",
    "test:accounting": "npm test --prefix modules/accounting",
    "db:migrate:accounting": "npm run db:migrate:accounting --prefix backend",
    "db:init": "npm run db:init --prefix backend",
    "admin:reset-password": "npm run admin:reset-password --prefix backend",
    "db:migrate:password-recovery": "npm run db:migrate:password-recovery --prefix backend",
    "db:migrate:centres": "npm run db:migrate:centres --prefix backend",
    "db:migrate:ratings": "npm run db:migrate:ratings --prefix backend",
    "db:migrate:imports": "npm run db:migrate:imports --prefix backend",
    "db:migrate:fruita": "npm run db:migrate:fruita --prefix backend",
    "db:migrate:paper": "npm run db:migrate:paper --prefix backend",
    "db:migrate:fusta-mat-inade": "npm run db:migrate:fusta-mat-inade --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
