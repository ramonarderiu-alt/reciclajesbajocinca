{
  "name": "reciclajes-bajo-cinca",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "db:init": "npm run db:init --prefix backend",
    "db:migrate:centres": "npm run db:migrate:centres --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
