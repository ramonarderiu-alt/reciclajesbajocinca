NODE_ENV=development
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reciclajes_app
DB_PASSWORD=change-me
DB_NAME=reciclajes_bajo_cinca
# Opcional: per defecte usa DB_NAME amb taules accounting_*. Pot apuntar a una base dedicada.
# ACCOUNTING_DB_NAME=reciclajes_bajo_cinca_accounting
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5174
COOKIE_SECURE=false
TRUST_PROXY=false
MAX_UPLOAD_MB=5
ADMIN_EMAIL=admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_NAME=Administrador

# Configura aquests valors a backend/.env, que és el fitxer que llegeix l’API.
# Per recuperar contrasenyes a localhost: APP_PUBLIC_URL=http://localhost:5174 amb NODE_ENV=development.
APP_PUBLIC_URL=https://compostatge.coopbellcaire.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Únic destinatari de les recuperacions de contrasenya de tots els usuaris.
PASSWORD_RECOVERY_TO=
