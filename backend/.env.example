NODE_ENV=development
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reciclajes_app
DB_PASSWORD=change-me
DB_NAME=reciclajes_bajo_cinca
# Opcional: per defecte usa DB_NAME amb taules accounting_*. Pot apuntar a una base dedicada.
# ACCOUNTING_DB_NAME=reciclajes_bajo_cinca_accounting
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5174
COOKIE_SECURE=false
TRUST_PROXY=false
MAX_UPLOAD_MB=5
ADMIN_EMAIL=admin@reciclajesbajocinca.es
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrador

# Correu de recuperació de contrasenyes (contrasenya d'aplicació de Gmail).
# Recuperació local: http://localhost:5174 amb NODE_ENV=development.
# Producció: https://compostatge.coopbellcaire.com.
APP_PUBLIC_URL=https://compostatge.coopbellcaire.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reciclajesbajocinca@gmail.com
SMTP_PASSWORD=
MAIL_FROM=reciclajesbajocinca@gmail.com

# Únic destinatari de les recuperacions de contrasenya de TOTS els usuaris.
# Utilitza APP_PUBLIC_URL i la configuració SMTP_* del servidor.
PASSWORD_RECOVERY_TO=

# JSON array. Generate a unique random token per agent and store only its SHA-256 here.
# SCALE_DEVICES=[{"id":"factory-1","companyId":1,"tokenHash":"<64 lowercase hex characters>","simulation":false}]
SCALE_DEVICES=[]
